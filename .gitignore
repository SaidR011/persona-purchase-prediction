# Files git should NOT upload to GitHub

# The downloaded dataset (about 400 MB). Anyone can re-download it with get_data.py
data/

# The Python tool box. Anyone can rebuild it with: pip install datasets pandas
.venv/

# Temporary files
scratch/
__pycache__/
.DS_Store

# Trained adapters (about 30 MB per checkpoint, 500+ MB in total). Too big for GitHub;
# they can be recreated with the training commands.
adapters/
